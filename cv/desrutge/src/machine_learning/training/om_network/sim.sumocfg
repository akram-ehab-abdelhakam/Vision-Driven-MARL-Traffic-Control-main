<?xml version="1.0" encoding="UTF-8"?>

<!--
    sim.sumocfg  —  SUMO configuration for DesRUTGe headless run  (OM Network)
    Path: desrutge/src/machine_learning/training/om_network/sim.sumocfg

    ⚠️  THIS FILE IS FOR DESRUTGE ONLY.
        It is used by SIMULA.py's llamar_SUMO() function to run a headless
        SUMO simulation AFTER duarouter generates routes.rou.xml.
        It does NOT replace your RL system's OM.sumocfg.

    WHAT THIS DOES IN THE DESRUTGE PIPELINE:
        1. DesRUTGe PPO calibrates a vehicle count (cant_coches).
        2. crear_OD()   → om_network/od_file.od
        3. crear_trips() → om_network/trips.xml      (via od2trips)
        4. validar_trips()→ om_network/trips_via.xml
        5. crear_rutas() → om_network/routes.rou.xml  (via duarouter)
        6. llamar_SUMO() → runs this sumocfg headlessly
           SUMO writes the inductionLoop output files (det_*.xml)
           which FARM.py reads to validate the generated demand.

    FILE REFERENCES (all relative to this file's directory):
        net-file:         osm.net.xml          (copy of OM.net.xml)
        route-files:      routes.rou.xml        (generated by duarouter)
        additional-files: detectors.add.xml     (inductionLoop detectors)

    SIMULATION PARAMETERS:
        begin=0, end=3600  → 1-hour simulation (matches CV interval profile)
        time-to-teleport=300  → matches original DesRUTGe Barcelona config
        no-warnings → suppress terminal noise during offline run

    NOTE: junction-taz is NOT set here because DesRUTGe uses edge-based TAZ
    (miniTAZ.xml with tazSource/tazSink on real edges, not junctions).
-->

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <!-- Network: copy of your OM.net.xml placed in om_network/ as osm.net.xml -->
        <net-file value="osm.net.xml"/>

        <!-- Routes: generated by DesRUTGe's duarouter chain (crear_rutas) -->
        <route-files value=""/>

        <!-- Detectors: inductionLoop only — required by FARM.py -->
        <additional-files value="detectors.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

    <processing>
        <!-- Vehicles that cannot route after 300s are teleported (avoids hangs) -->
        <time-to-teleport value="300"/>
    </processing>

    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
    </report>

</configuration>
